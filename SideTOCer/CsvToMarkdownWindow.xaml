<Window x:Class="SideTOCer.CsvToMarkdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV ↔ Markdown 相互変換ツール"
        Height="500" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{DynamicResource BrHeader}">
            <Grid Margin="16,0">
                <TextBlock Text="CSV ↔ Markdown テーブル相互変換" Foreground="White" 
                           VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource PrimaryButton}" 
                            Margin="0,0,8,0"
                            Click="BtnCopyCsv_Click">CSVをコピー</Button>
                    <Button Style="{DynamicResource PrimaryButton}" 
                            Click="BtnCopyMd_Click">MDをコピー</Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メインエリア -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CSV入力 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource BrSidebar}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="0,0,1,1">
                    <TextBlock Text="CSV (カンマ区切り)" Foreground="{DynamicResource BrTextLabel}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                </Border>
                <TextBox x:Name="CsvInput" Grid.Row="1"
                         AcceptsReturn="True" AcceptsTab="True"
                         Padding="12" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BrBorder}"
                         Background="{DynamicResource BrBg}" Foreground="{DynamicResource BrText}"
                         CaretBrush="{DynamicResource BrText}"
                         FontFamily="Consolas" FontSize="13"
                         TextChanged="CsvInput_TextChanged"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BrBorder}"/>

            <!-- Markdown入力 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource BrSidebar}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Markdown テーブル" Foreground="{DynamicResource BrTextLabel}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                </Border>
                <TextBox x:Name="MdOutput" Grid.Row="1"
                         AcceptsReturn="True" AcceptsTab="True"
                         Padding="12" BorderThickness="0"
                         Background="{DynamicResource BrBg}" Foreground="{DynamicResource BrText}"
                         CaretBrush="{DynamicResource BrText}"
                         FontFamily="Consolas" FontSize="13"
                         TextChanged="MdOutput_TextChanged"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
