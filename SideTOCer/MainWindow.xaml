<Window x:Class="SideTOCer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MD → HTML ビューワー"
        Height="800" Width="1280"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{DynamicResource BrHeader}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Markdown操作 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource HeaderButton}" Click="BtnOpen_Click" Margin="0,0,8,0">開く</Button>
                    <Button Style="{DynamicResource HeaderButton}" Click="BtnSave_Click" Margin="0,0,8,0">保存</Button>
                    <Button Style="{DynamicResource HeaderButton}" Click="BtnSaveAs_Click" Margin="0,0,8,0">名前を付けて保存</Button>
                    <Button Style="{DynamicResource HeaderButton}" Click="BtnClear_Click" Margin="0,0,8,0">クリア</Button>
                    <Button Style="{DynamicResource HeaderButton}" Click="BtnCsvTool_Click">CSV↔MD変換</Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock x:Name="DocumentStatusText"
                               Foreground="#C7D7F5"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Width="150"
                               Margin="0,0,12,0"/>
                    
                    <CheckBox x:Name="OptAccordion" Content="ｱｺｰﾃﾞｨｵﾝ一括操作" Foreground="White" 
                              VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"
                              Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="OptBackToTop" Content="上に戻るﾎﾞﾀﾝ" Foreground="White" 
                              VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"
                              Checked="Option_Changed" Unchecked="Option_Changed"/>

                    <!-- 見出し番号振り設定グループ -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <CheckBox x:Name="OptAutoNumber" Content="見出し番号振り" Foreground="White" 
                                  FontSize="12" IsChecked="False"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="OptH2Base" Content="└ H2を第1章にする" Foreground="#C7D7F5" 
                                  FontSize="10.5" Margin="12,2,0,0" IsChecked="False"
                                  IsEnabled="{Binding ElementName=OptAutoNumber, Path=IsChecked}"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                    </StackPanel>

                    <!-- ダークモード設定グループ -->
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="OptDarkMode" Content="ﾀﾞｰｸﾓｰﾄﾞ" Foreground="White" 
                                  FontSize="12" IsChecked="False"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="OptHtmlLight" Content="└ HTML保存はﾗｲﾄﾓｰﾄﾞ" Foreground="#C7D7F5" 
                                  FontSize="10.5" Margin="12,2,0,0" IsChecked="False"
                                  IsEnabled="{Binding ElementName=OptDarkMode, Path=IsChecked}"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                    </StackPanel>
                    <CheckBox x:Name="OptHalfImage" Content="画像縮小" Foreground="White" 
                              VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="False"
                              Checked="Option_Changed" Unchecked="Option_Changed"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{DynamicResource PrimaryButton}"
                        VerticalAlignment="Center"
                        Click="BtnExport_Click">HTML保存</Button>
            </Grid>
        </Border>

        <!-- 検索バー -->
        <Border x:Name="SearchBar" Grid.Row="1" Background="{DynamicResource BrSidebar}" 
                BorderBrush="{DynamicResource BrBorder}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid Height="44">
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="検索" Foreground="{DynamicResource BrTextLabel}" 
                               FontSize="11" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Width="200" Height="26" Padding="6,2"
                             Background="{DynamicResource BrBg}" Foreground="{DynamicResource BrText}"
                             BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"
                             CaretBrush="{DynamicResource BrText}"/>
                    <StackPanel x:Name="SearchNavigationControls" Orientation="Horizontal">
                        <Button Content="前へ" Click="BtnSearchPrev_Click" Margin="8,0,4,0" Width="50" Height="26"
                                Background="{DynamicResource BrSearchBtnBg}" Foreground="{DynamicResource BrSearchBtnText}"
                                BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="次へ" Click="BtnSearchNext_Click" Margin="0,0,16,0" Width="50" Height="26"
                                Background="{DynamicResource BrSearchBtnBg}" Foreground="{DynamicResource BrSearchBtnText}"
                                BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="ReplaceControls" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="置換" Foreground="{DynamicResource BrTextLabel}" 
                                   FontSize="11" FontWeight="Bold" Margin="8,0,12,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReplaceBox" Width="200" Height="26" Padding="6,2"
                                 Background="{DynamicResource BrBg}" Foreground="{DynamicResource BrText}"
                                 BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource BrText}"/>
                        <Button Content="一括置換" Click="BtnReplaceAll_Click" Margin="8,0,12,0" Width="70" Height="26"
                                Background="{DynamicResource BrSearchBtnBg}" Foreground="{DynamicResource BrSearchBtnText}"
                                BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="[Enter]次へ  [Esc]閉じる" Foreground="{DynamicResource BrTextSub}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                        Content="✕" Click="BtnCloseSearch_Click" Width="24" Height="24"
                        Background="{DynamicResource BrSearchBtnBg}" Foreground="{DynamicResource BrSearchBtnText}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"/>
            </Grid>
        </Border>

        <!-- ワークスペース -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="240" MinWidth="160"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- エディタペイン -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource BrSidebar}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="0,0,1,1">
                    <TextBlock Text="MARKDOWN エディタ" Foreground="{DynamicResource BrTextLabel}"
                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="16,0"/>
                </Border>
                <TextBox x:Name="Editor"
                         Grid.Row="1"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13.5"
                         Foreground="{DynamicResource BrText}"
                         Background="{DynamicResource BrBg}"
                         BorderThickness="0,0,1,0"
                         BorderBrush="{DynamicResource BrBorder}"
                         Padding="24"
                         TextChanged="Editor_TextChanged"
                         AllowDrop="True"
                         PreviewDragOver="Editor_DragOver"
                         PreviewDrop="Editor_Drop"
                         Drop="Editor_Drop"
                         DragOver="Editor_DragOver"
                         IsInactiveSelectionHighlightEnabled="True"
                         SelectionBrush="{DynamicResource BrAccent}"
                         SelectionOpacity="0.4">
                    <TextBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>
                    </TextBox.Resources>
                </TextBox>
            </Grid>

            <!-- スプリッター（エディタ↔目次） -->
            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BrBorder}"/>

            <!-- 目次サイドバー -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource BrSidebar}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="0,0,1,1">
                    <TextBlock Text="目次" Foreground="{DynamicResource BrTextLabel}"
                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="16,0"/>
                </Border>
                <ListBox x:Name="TocList"
                         Grid.Row="1"
                         Background="{DynamicResource BrSidebar}"
                         BorderThickness="0,0,1,0"
                         BorderBrush="{DynamicResource BrBorder}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{DynamicResource TocItem}"
                         SelectionChanged="TocList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LevelDisplay}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Width="22"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrTextLabel}"/>
                                <TextBlock Text="{Binding FullText}"
                                           FontSize="{Binding FontSize}"
                                           FontWeight="{Binding FontWeight}"
                                           Margin="{Binding Indent}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 一括操作ボタン -->
                <Border Grid.Row="2" Background="{DynamicResource BrSidebar}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="0,1,1,0"
                        Visibility="{Binding ElementName=OptAccordion, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <UniformGrid Columns="2" Margin="4">
                        <Button Content="すべて開く" Click="BtnExpandAll_Click" 
                                Background="{DynamicResource BrSearchBtnBg}" Foreground="{DynamicResource BrSearchBtnText}"
                                BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                Margin="4" Padding="0,4" FontSize="11" Cursor="Hand"/>
                        <Button Content="すべて閉じる" Click="BtnCollapseAll_Click" 
                                Background="{DynamicResource BrSearchBtnBg}" Foreground="{DynamicResource BrSearchBtnText}"
                                BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                Margin="4" Padding="0,4" FontSize="11" Cursor="Hand"/>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- プレビュー -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource BrSidebar}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="0,0,0,1">
                    <TextBlock Text="プレビュー" Foreground="{DynamicResource BrTextLabel}"
                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="16,0"/>
                </Border>
                <wv2:WebView2 x:Name="Preview" Grid.Row="1"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
